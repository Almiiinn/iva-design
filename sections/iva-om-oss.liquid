{%- comment -%}
  IVA – Om oss (sections/iva-om-oss.liquid). Sida: /pages/om-oss (mall "om-oss").
  Allt är redigerbart i temaredigeraren: rubrik, historia, bild, värderingar (block), citat, siffror (block), CTA.
{%- endcomment -%}

<section class="ivom">
  <div class="ivom-inner">

    <div class="ivom-head">
      <p class="ivom-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      {%- if section.settings.intro != blank -%}<div class="ivom-lead">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    {%- if section.settings.image -%}
      <div class="ivom-hero{% if section.settings.image.aspect_ratio < 1 %} ivom-hero--portrait{% endif %}">
        <img src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
          sizes="(max-width: 860px) 100vw, 1180px" alt="{{ section.settings.image.alt | default: 'IVA design' | escape }}"
          width="2000" height="{{ 2000 | divided_by: section.settings.image.aspect_ratio | round }}" loading="eager"
          style="object-position: {{ section.settings.image_focus }};">
      </div>
    {%- endif -%}

    {%- assign vals = section.blocks | where: 'type', 'value' -%}
    {%- if vals.size > 0 -%}
      <div class="ivom-vals">
        {%- for block in vals -%}
          <div {{ block.shopify_attributes }}>
            <p class="ivom-eyebrow">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <div class="ivom-quote">
        <blockquote>”{{ section.settings.quote }}”</blockquote>
        {%- if section.settings.quote_by != blank -%}<p class="ivom-eyebrow">{{ section.settings.quote_by }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign nums = section.blocks | where: 'type', 'stat' -%}
    {%- if nums.size > 0 -%}
      <div class="ivom-nums">
        {%- for block in nums -%}
          <div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="ivom-cta"><a class="ivom-btn" href="{{ section.settings.cta_link | default: '/collections/produkter' }}">{{ section.settings.cta_label }}</a></div>
    {%- endif -%}
  </div>
</section>

<style>
  .ivom { background: #faf6f0; color: #1D1D1F; padding: 3rem 1.25rem 5rem; margin-bottom: -2px; }
  .ivom * { box-sizing: border-box; }
  .ivom-inner { max-width: 1180px; margin: 0 auto; }
  .ivom-eyebrow { font-size: .65rem; letter-spacing: 3px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .6rem; }
  .ivom-head { text-align: center; max-width: 720px; margin: 0 auto 2.5rem; }
  .ivom h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(2.2rem, 4.4vw, 3.6rem); margin: 0 0 1rem; line-height: 1.1; color: #1D1D1F !important; }
  .ivom-lead { color: rgba(29,29,31,.68); font-size: 1.02rem; line-height: 1.7; }
  .ivom-lead p { margin: 0 0 .8rem; } .ivom-lead p:last-child { margin: 0; }
  .ivom-hero { border-radius: 24px; overflow: hidden; aspect-ratio: 16 / 8; background: #f0e6d3; }
  .ivom-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ivom-hero--portrait { aspect-ratio: auto; max-width: 620px; margin-left: auto; margin-right: auto; }
  .ivom-hero--portrait img { height: auto; object-fit: contain; }
  .ivom-vals { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 3.5rem; }
  .ivom-vals h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 1.6rem; margin: .2rem 0 .5rem; color: #1D1D1F !important; }
  .ivom-vals p:last-child { color: rgba(29,29,31,.68); margin: 0; line-height: 1.65; }
  .ivom-quote { text-align: center; margin-top: 4.5rem; }
  .ivom-quote blockquote { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 500; max-width: 720px; margin: 0 auto 1rem; line-height: 1.25; }
  .ivom-nums { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; text-align: center; }
  .ivom-nums div { background: #f7f3eb; border: 1px solid rgba(29,29,31,.09); border-radius: 18px; padding: 1.6rem 1rem; }
  .ivom-nums b { display: block; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.1rem; font-weight: 500; line-height: 1.1; }
  .ivom-nums span { font-size: .7rem; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(29,29,31,.62); }
  .ivom-cta { text-align: center; margin-top: 3.5rem; }
  .ivom-btn { display: inline-flex; align-items: center; background: #1D1D1F; color: #fff !important; border-radius: 50px; padding: 1rem 2rem; font-size: .68rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .ivom-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.16); }
  @media (min-width: 860px) {
    .ivom { padding: 4.5rem 2.5rem 6rem; }
    .ivom-vals { grid-template-columns: repeat(3, 1fr); gap: 3rem; margin-top: 5rem; }
    .ivom-nums { grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 5rem; }
    .ivom-quote { margin-top: 6rem; }
  }
</style>

{% schema %}
{
  "name": "IVA Om oss",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Liten rubrik", "default": "Vår historia" },
    { "type": "textarea", "id": "heading", "label": "Rubrik (radbryt med Enter)", "default": "Vi tröttnade på att leta\nefter våra AirPods." },
    { "type": "richtext", "id": "intro", "label": "Inledning", "default": "<p>Så vi gjorde ett skal som löser problemet. IVA föddes ur en enkel idé: telefonen är redan alltid med – låt den bära resten. AirPods, läppglans, parfym eller penna, i ett skal som ser lika bra ut som det är praktiskt.</p>" },
    { "type": "header", "content": "Bild" },
    { "type": "image_picker", "id": "image", "label": "Bild (liggande, t.ex. hero-bilden)" },
    { "type": "select", "id": "image_focus", "label": "Fokuspunkt", "default": "center 45%", "options": [ { "value": "center 20%", "label": "Uppe" }, { "value": "center 45%", "label": "Något över mitten" }, { "value": "center", "label": "Mitten" }, { "value": "center 70%", "label": "Nere" } ] },
    { "type": "header", "content": "Citat" },
    { "type": "text", "id": "quote", "label": "Citat", "default": "Vi ville göra en sak riktigt bra – inte hundra saker halvbra." },
    { "type": "text", "id": "quote_by", "label": "Vem", "default": "Grundarna, IVA design" },
    { "type": "header", "content": "Knapp" },
    { "type": "text", "id": "cta_label", "label": "Knapptext", "default": "Upptäck kollektionen" },
    { "type": "url", "id": "cta_link", "label": "Länk" }
  ],
  "blocks": [
    {
      "type": "value", "name": "Värdering",
      "settings": [
        { "type": "text", "id": "title", "label": "Rubrik", "default": "Design med syfte" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Varje detalj finns där av en anledning. Inga onödiga utsmyckningar – bara funktion som känns självklar." }
      ]
    },
    {
      "type": "stat", "name": "Siffra",
      "settings": [
        { "type": "text", "id": "value", "label": "Siffra/värde", "default": "1–3 dagar" },
        { "type": "text", "id": "label", "label": "Etikett", "default": "leveranstid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IVA Om oss",
      "blocks": [
        { "type": "value", "settings": { "title": "Design med syfte", "text": "Varje detalj finns där av en anledning. Inga onödiga utsmyckningar – bara funktion som känns självklar." } },
        { "type": "value", "settings": { "title": "Material som håller", "text": "Mjuk silikon, förhöjda kanter runt kamera och skärm och en hållare som sitter kvar. Ett skal som tål vardagen." } },
        { "type": "value", "settings": { "title": "Enkelt hela vägen", "text": "Beställ före kl 11 så skickar vi samma dag. 30 dagars öppet köp och svar från oss inom två arbetsdagar." } },
        { "type": "stat", "settings": { "value": "1–3 dagar", "label": "leveranstid" } },
        { "type": "stat", "settings": { "value": "30 dagar", "label": "öppet köp" } },
        { "type": "stat", "settings": { "value": "iPhone 13–17", "label": "modeller" } },
        { "type": "stat", "settings": { "value": "Sverige", "label": "designat & skickat" } }
      ]
    }
  ]
}
{% endschema %}