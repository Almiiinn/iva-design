{% comment %}
  IVA Kundgalleri — "Från våra kunder"
  Ljus sektion med auto-scrollande kundbilder i två rader (vänster + höger).
  Hovra för att pausa karusellen.
{% endcomment %}

<section class="ivcg">

  <!-- RUBRIK -->
  <div class="ivcg-header">
    {%- assign star_count = section.settings.stars -%}
    {%- if star_count > 0 -%}
      <p class="ivcg-stars" aria-hidden="true">
        {%- for i in (1..star_count) -%}★{%- endfor -%}
      </p>
    {%- endif -%}
    {%- if section.settings.label != blank -%}
      <p class="ivcg-label">{{ section.settings.label }}</p>
    {%- endif -%}
    <h2 class="ivcg-heading">{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="ivcg-desc">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <!-- RAD 1 — scrollar vänster -->
  <div class="ivcg-row-wrap">
    <div class="ivcg-row ivcg-row--left">
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          <div class="ivcg-card" {{ block.shopify_attributes }}>
            <div class="ivcg-card-img-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 480 }}"
                  alt="{{ block.settings.handle | default: 'Kundbild' | escape }}"
                  class="ivcg-card-img"
                  loading="lazy"
                  width="480"
                  height="{{ 480 | divided_by: block.settings.image.aspect_ratio | round }}"
                >
              {%- else -%}
                <div class="ivcg-card-placeholder"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.handle != blank -%}
              <p class="ivcg-card-name">{{ block.settings.handle }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      <!-- Kopia för sömlös loop -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          <div class="ivcg-card" aria-hidden="true">
            <div class="ivcg-card-img-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 480 }}"
                  alt=""
                  class="ivcg-card-img"
                  loading="lazy"
                  width="480"
                  height="{{ 480 | divided_by: block.settings.image.aspect_ratio | round }}"
                >
              {%- else -%}
                <div class="ivcg-card-placeholder"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.handle != blank -%}
              <p class="ivcg-card-name">{{ block.settings.handle }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>


</section>

<style>
  /* ── SEKTION ── */
  .ivcg {
    padding: 5rem 0 6rem;
    background: linear-gradient(180deg, #f9f3eb 0%, #f0e6d3 50%, #f9f3eb 100%);
    overflow: hidden;
    position: relative;
    margin-bottom: -2px;
  }

  /* ── RUBRIK ── */
  .ivcg-header {
    text-align: center;
    padding: 0 1.5rem;
    margin-bottom: 3rem;
  }

  .ivcg-stars {
    color: #1D1D1F;
    font-size: 1.15rem;
    letter-spacing: 4px;
    margin: 0 0 .7rem;
  }

  .ivcg-label {
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #1D1D1F;
    margin: 0 0 .9rem;
  }

  .ivcg-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -.3px;
    color: #1D1D1F;
    margin: 0 0 .9rem;
  }

  .ivcg-desc {
    font-size: .9rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(29,29,31,0.55);
    max-width: 420px;
    margin: 0 auto;
  }

  /* ── SCROLL-RAD ── */
  .ivcg-row-wrap {
    overflow: hidden;
    cursor: grab;
    margin-bottom: 0;
    /* Gradient-masker vänster/höger — kortens in- och utfart tonas mjukt */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  .ivcg-row-wrap.is-dragging { cursor: grabbing; }

  .ivcg-row {
    display: flex;
    gap: 1rem;
    width: max-content;
  }

  /* ── KORT ── */
  .ivcg-card {
    flex-shrink: 0;
    width: 200px;
  }

  .ivcg-card-img-wrap {
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    overflow: hidden;
    background: #E8DFD3;
    margin-bottom: .6rem;
  }

  .ivcg-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }

  .ivcg-card:hover .ivcg-card-img { transform: scale(1.04); }

  .ivcg-card-placeholder {
    width: 100%;
    height: 100%;
    background: #DDD6CC;
  }

  .ivcg-card-name {
    font-size: .7rem;
    font-weight: 500;
    color: rgba(29,29,31,0.45);
    margin: 0;
    letter-spacing: .3px;
    padding: 0 .2rem;
  }

  /* ── DESKTOP ── */
  @media (min-width: 769px) {
    .ivcg { padding: 5rem 0 3rem; }
    .ivcg-header { margin-bottom: 4.5rem; }
    .ivcg-heading { font-size: clamp(2rem, 3vw, 2.6rem); }
    .ivcg-desc { font-size: 1.05rem; max-width: 500px; }
    .ivcg-card { width: 260px; }
    .ivcg-card-img-wrap { border-radius: 20px; }
    .ivcg-row { gap: 1.5rem; }
    .ivcg-row-wrap { margin-bottom: 0; }
  }

  /* ── MOBIL ── */
  @media (max-width: 600px) {
    .ivcg { padding: 1rem 0 2rem; }
    .ivcg-header { margin-bottom: 1.5rem; }
    .ivcg-card { width: 145px; }
    .ivcg-card-img-wrap { border-radius: 10px; }
    .ivcg-row { gap: .7rem; }
  }
</style>

<script>
(function () {
  var wrap = document.querySelector('.ivcg-row-wrap');
  if (!wrap) return;
  var row = wrap.querySelector('.ivcg-row');
  if (!row) return;

  var AUTO_SPEED   = 1.2;   /* px per bildruta */
  var offset       = 0;     /* hur långt vi förflyttat raden */
  var dragging     = false;
  var startX       = 0;
  var startOffset  = 0;
  var touchStartY  = 0;
  var touchIsHoriz = null;

  /* Halva bredden = bredden på en kopia av innehållet */
  function half() {
    return row.offsetWidth / 2;
  }

  /* Normalisera: håll offset inom [0, half) för sömlös loop */
  function setPos(x) {
    var h = half();
    if (h > 0) {
      x = x % h;
      if (x < 0) x += h;
    }
    offset = x;
    row.style.transform = 'translateX(-' + offset + 'px)';
  }

  /* Auto-scroll via transform — fungerar på alla webbläsare inkl. iOS */
  function tick() {
    if (!dragging) {
      setPos(offset + AUTO_SPEED);
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  /* ── MUS (desktop) ── */
  wrap.addEventListener('mousedown', function (e) {
    dragging    = true;
    startX      = e.pageX;
    startOffset = offset;
    wrap.classList.add('is-dragging');
    e.preventDefault();
  });

  document.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    setPos(startOffset + (startX - e.pageX));
  });

  document.addEventListener('mouseup', function () {
    if (!dragging) return;
    dragging = false;
    wrap.classList.remove('is-dragging');
  });

  /* ── TOUCH (mobil) ── */
  wrap.addEventListener('touchstart', function (e) {
    startX       = e.touches[0].pageX;
    touchStartY  = e.touches[0].pageY;
    startOffset  = offset;
    dragging     = false;
    touchIsHoriz = null;
  }, { passive: true });

  wrap.addEventListener('touchmove', function (e) {
    var dx = e.touches[0].pageX - startX;
    var dy = e.touches[0].pageY - touchStartY;

    if (touchIsHoriz === null) {
      touchIsHoriz = Math.abs(dx) > Math.abs(dy);
    }

    /* Vertikal svepning — låt sidan scrolla normalt */
    if (!touchIsHoriz) return;

    /* Horisontell svepning — ta kontroll */
    e.preventDefault();
    dragging = true;
    setPos(startOffset - dx);
  }, { passive: false });

  wrap.addEventListener('touchend', function () {
    dragging     = false;
    touchIsHoriz = null;
  });
})();
</script>

{% schema %}
{
  "name": "IVA Kundgalleri",
  "settings": [
    { "type": "color",    "id": "bg_color",     "label": "Bakgrundsfärg",           "default": "#F5EDE2" },
    { "type": "range",    "id": "stars",         "label": "Stjärnor (0 = dölj)",    "min": 0, "max": 5, "step": 1, "default": 5 },
    { "type": "text",     "id": "label",         "label": "Liten etikett",           "default": "Från våra kunder" },
    { "type": "textarea", "id": "heading",       "label": "Rubrik",                  "default": "Älskade av tusentals" },
    { "type": "textarea", "id": "description",   "label": "Beskrivning",             "default": "Riktiga kunder, riktiga liv — se hur IVA passar in i vardagen." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Kundbild",
      "settings": [
        { "type": "image_picker", "id": "image",  "label": "Bild" },
        { "type": "text",         "id": "handle", "label": "Namn / @handle", "default": "@kund" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IVA Kundgalleri",
      "blocks": [
        { "type": "photo", "settings": { "handle": "@ida.m" } },
        { "type": "photo", "settings": { "handle": "@sara.k" } },
        { "type": "photo", "settings": { "handle": "@johanna" } },
        { "type": "photo", "settings": { "handle": "@emilia.s" } },
        { "type": "photo", "settings": { "handle": "@linnea" } },
        { "type": "photo", "settings": { "handle": "@maja.f" } }
      ]
    }
  ]
}
{% endschema %}