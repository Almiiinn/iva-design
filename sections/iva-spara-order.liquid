{%- comment -%}
  IVA – Spåra min order (sections/iva-spara-order.liquid). Sida: /pages/spara-order (mall "spara-order").
  Två vägar: 1) PostNord-spårning med kollinummer, 2) inloggning → Mina ordrar (orderstatus med spårningslänk).
{%- endcomment -%}

<section class="ivso">
  <div class="ivso-inner">
    <div class="ivso-head">
      <p class="ivso-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ivso-intro">{{ section.settings.intro }}</p>
    </div>

    <div class="ivso-grid">
      <div class="ivso-card">
        <p class="ivso-eyebrow">Alternativ 1</p>
        <h2>Spåra med kollinummer</h2>
        <p class="ivso-sub">Kollinumret hittar du i leveransbekräftelsen vi mejlade när paketet skickades. Alla paket skickas med PostNord.</p>
        <form class="ivso-form" id="ivsoForm" action="https://tracking.postnord.com/se/" method="get" target="_blank" rel="noopener">
          <label for="ivsoId">Kollinummer</label>
          <div class="ivso-row">
            <input type="text" id="ivsoId" name="id" required inputmode="text" autocomplete="off" placeholder="T.ex. 0037…" pattern="[A-Za-z0-9]{8,35}" title="Ange kollinumret utan mellanslag">
            <button type="submit" class="ivso-btn">Spåra</button>
          </div>
          <p class="ivso-fine">Du skickas till PostNords spårningssida i en ny flik.</p>
        </form>
      </div>

      <div class="ivso-card">
        <p class="ivso-eyebrow">Alternativ 2</p>
        <h2>Se dina ordrar</h2>
        {%- if customer -%}
          <p class="ivso-sub">Hej {{ customer.first_name | default: 'där' }}! Under Mina ordrar ser du status och spårningslänk för varje beställning.</p>
          <a class="ivso-btn ivso-btn--wide" href="/pages/mitt-konto#ordrar">Till mina ordrar</a>
        {%- else -%}
          <p class="ivso-sub">Logga in med den e-postadress du beställde med så ser du status och spårningslänk för varje beställning.</p>
          {%- assign ivso_login = routes.storefront_login_url | split: '?' | first | append: '?return_to=%2Fpages%2Fmitt-konto' -%}
          <a class="ivso-btn ivso-btn--wide" href="{{ ivso_login }}">Logga in</a>
        {%- endif -%}
        <p class="ivso-fine">Du kan också klicka på ”Visa din order” i orderbekräftelsen.</p>
      </div>
    </div>

    <div class="ivso-steps">
      <p class="ivso-eyebrow">Så här går det till</p>
      <ol>
        <li><b>Orderbekräftelse</b><span>Direkt efter köpet får du ett mejl med ordernummer och innehåll.</span></li>
        <li><b>Leveransbekräftelse</b><span>När paketet lämnar oss får du ett mejl med kollinummer och spårningslänk.</span></li>
        <li><b>På väg</b><span>PostNord levererar inom 1–3 arbetsdagar och aviserar via sms eller mejl när paketet kan hämtas.</span></li>
      </ol>
    </div>

    <div class="ivso-help">
      <p>Hittar du inte ditt paket, eller har det gått mer än 5 arbetsdagar? <a href="/pages/kontakt">Kontakta oss</a> med ditt ordernummer så hjälper vi dig.</p>
    </div>
  </div>
</section>

<style>
  .ivso { background: #faf6f0; color: #1D1D1F; padding: 2.5rem 1.25rem 4rem; margin-bottom: -2px; }
  .ivso * { box-sizing: border-box; }
  .ivso-inner { max-width: 1000px; margin: 0 auto; }
  .ivso-eyebrow { font-size: .65rem; letter-spacing: 3px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .6rem; }
  .ivso-head { text-align: center; max-width: 620px; margin: 0 auto 2.5rem; }
  .ivso h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(2.4rem, 4vw, 3.4rem); margin: .2rem 0 .8rem; color: #1D1D1F !important; line-height: 1.1; }
  .ivso-intro { color: rgba(29,29,31,.65); margin: 0; line-height: 1.65; }
  .ivso-grid { display: grid; grid-template-columns: 1fr; gap: 1.2rem; }
  .ivso-card { background: #f7f3eb; border: 1px solid rgba(29,29,31,.09); border-radius: 18px; padding: 1.8rem 1.4rem; display: flex; flex-direction: column; }
  .ivso-card h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 1.8rem; margin: 0 0 .4rem; color: #1D1D1F !important; }
  .ivso-sub { color: rgba(29,29,31,.65); font-size: .92rem; line-height: 1.6; margin: 0 0 1.3rem; }
  .ivso-form label { display: block; font-size: .66rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .45rem; }
  .ivso-row { display: flex; flex-direction: column; gap: .6rem; }
  .ivso-row input { width: 100%; background: #fff; border: 1px solid rgba(29,29,31,.12); border-radius: 50px; padding: .95rem 1.2rem; font: inherit; font-size: .95rem; color: #1D1D1F; outline: none; transition: border-color .2s; }
  .ivso-row input:focus { border-color: #1D1D1F; }
  .ivso-btn { display: inline-flex; align-items: center; justify-content: center; background: #1D1D1F; color: #fff !important; border: 1.5px solid #1D1D1F; border-radius: 50px; padding: 1rem 1.8rem; font-size: .68rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; cursor: pointer; font-family: inherit; white-space: nowrap; transition: transform .2s, box-shadow .2s; }
  .ivso-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.16); }
  .ivso-btn--wide { width: 100%; margin-top: auto; }
  .ivso-fine { font-size: .74rem; color: rgba(29,29,31,.6); margin: .9rem 0 0; line-height: 1.5; }
  .ivso-steps { margin-top: 3rem; }
  .ivso-steps ol { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .ivso-steps li { counter-increment: s; position: relative; padding: 1.2rem 1.2rem 1.2rem 3.6rem; background: #fff; border: 1px solid rgba(29,29,31,.09); border-radius: 16px; }
  .ivso-steps li::before { content: counter(s); position: absolute; left: 1.1rem; top: 1.1rem; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: #1D1D1F; color: #fff; font-size: .8rem; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .ivso-steps b { display: block; font-size: .95rem; margin-bottom: .2rem; }
  .ivso-steps span { font-size: .88rem; color: rgba(29,29,31,.65); line-height: 1.55; }
  .ivso-help { margin-top: 2.2rem; text-align: center; font-size: .92rem; color: rgba(29,29,31,.7); line-height: 1.6; }
  .ivso-help a { color: #1D1D1F; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 720px) {
    .ivso { padding: 4.5rem 2.5rem 5rem; }
    .ivso-grid { grid-template-columns: 1fr 1fr; gap: 1.6rem; }
    .ivso-card { padding: 2.4rem 2.2rem; }
    .ivso-row { flex-direction: row; }
    .ivso-steps ol { grid-template-columns: repeat(3, 1fr); }
  }
</style>

{% schema %}
{
  "name": "IVA Spåra min order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Liten rubrik", "default": "Leverans" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Spåra min order" },
    { "type": "textarea", "id": "intro", "label": "Inledning", "default": "Följ ditt paket hela vägen hem. Ange kollinumret från leveransbekräftelsen eller logga in för att se alla dina ordrar." }
  ],
  "presets": [ { "name": "IVA Spåra min order" } ]
}
{% endschema %}