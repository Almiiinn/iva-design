{% comment %}
  IVA Compare — "Varför IVA?"
  Mörk sektion: text till vänster, två stora paneler (vanligt skal | IVA-skal)
  där bakgrunden sträcker sig bakom produktbilderna. IVA-panelen har guld-glöd.
{% endcomment %}

<section class="ivcp">
  <div class="ivcp-inner">

    <!-- VÄNSTER: rubrik + text -->
    <div class="ivcp-left">
      <div class="ivcp-heading">{{ section.settings.heading | newline_to_br }}</div>
      {%- if section.settings.description != blank -%}
        <div class="ivcp-desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <!-- PANEL 1: Vanligt skal -->
    <div class="ivcp-panel ivcp-panel--plain">
      <div class="ivcp-glow ivcp-glow--plain" aria-hidden="true"></div>
      <div class="ivcp-panel-img">
        {%- if section.settings.image_plain != blank -%}
          <img
            src="{{ section.settings.image_plain | image_url: width: 500 }}"
            alt="{{ section.settings.col_plain_title | escape }}"
            class="ivcp-img"
            loading="lazy"
            width="500"
            height="{{ 500 | divided_by: section.settings.image_plain.aspect_ratio | round }}"
          >
        {%- else -%}
          <div class="ivcp-img-placeholder"></div>
        {%- endif -%}
      </div>
      <div class="ivcp-panel-col">
        <p class="ivcp-col-title">{{ section.settings.col_plain_title }}</p>
        <ul class="ivcp-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <li class="ivcp-row ivcp-row--bad" {{ block.shopify_attributes }}>
                <span class="ivcp-icon ivcp-icon--bad">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M15 9l-6 6M9 9l6 6"/>
                  </svg>
                </span>
                <span>{{ block.settings.plain_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <!-- PANEL 2: IVA-skal med glöd -->
    <div class="ivcp-panel ivcp-panel--iva">
      <div class="ivcp-glow" aria-hidden="true"></div>
      <div class="ivcp-panel-col">
        <p class="ivcp-col-title">{{ section.settings.col_iva_title }}</p>
        <ul class="ivcp-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <li class="ivcp-row ivcp-row--good" {{ block.shopify_attributes }}>
                <span class="ivcp-icon ivcp-icon--good">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 12l3 3 5-5"/>
                  </svg>
                </span>
                <span>{{ block.settings.iva_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="ivcp-panel-img">
        {%- if section.settings.image_iva != blank -%}
          <img
            src="{{ section.settings.image_iva | image_url: width: 500 }}"
            alt="{{ section.settings.col_iva_title | escape }}"
            class="ivcp-img"
            loading="lazy"
            width="500"
            height="{{ 500 | divided_by: section.settings.image_iva.aspect_ratio | round }}"
          >
        {%- else -%}
          <div class="ivcp-img-placeholder"></div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
  .ivcp {
    padding: 3rem 0 4rem;
    position: relative;
    background: linear-gradient(180deg, #f9f3eb 0%, #f0e6d3 30%, #f0e6d3 75%, #f9f3eb 93%, #faf6f0 100%);
  }

  .ivcp-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 3.5rem;
    display: grid;
    grid-template-columns: minmax(190px, 250px) 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  /* ── VÄNSTER TEXT ── */
  .ivcp-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.25rem;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -.3px;
    color: #1D1D1F;
    margin: 0 0 1.2rem;
  }

  .ivcp-desc {
    font-size: .875rem;
    font-weight: 300;
    line-height: 1.72;
    color: rgba(29,29,31,0.55);
    margin: 0;
  }

  /* ── PANELER ── */
  .ivcp-panel {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 2rem 1.5rem;
    gap: 1.25rem;
    min-height: 260px;
  }

  .ivcp-panel--plain { background: transparent; }
  .ivcp-panel--iva   { background: transparent; }

  /* ── GLÖD ── */
  .ivcp-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 130%;
    height: 130%;
    pointer-events: none;
    z-index: 0;
  }

  .ivcp-glow--plain {
    background: radial-gradient(
      circle,
      rgba(29,29,31,0.04) 0%,
      rgba(29,29,31,0.02) 35%,
      transparent 70%
    );
  }

  .ivcp-glow:not(.ivcp-glow--plain) {
    background: radial-gradient(
      circle,
      rgba(190,210,240,0.18) 0%,
      rgba(190,210,240,0.08) 35%,
      transparent 70%
    );
  }

  /* ── PRODUKTBILD ── */
  .ivcp-panel-img {
    position: relative;
    z-index: 1;
    flex: 0 0 38%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ivcp-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    max-height: 220px;
  }

  .ivcp-img-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1.7;
    background: rgba(29,29,31,0.06);
    border-radius: 10px;
  }

  /* ── LISTA ── */
  .ivcp-panel-col {
    position: relative;
    z-index: 1;
    flex: 1;
  }

  .ivcp-col-title {
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 1.1rem;
  }

  .ivcp-panel--plain .ivcp-col-title { color: rgba(29,29,31,0.4); }
  .ivcp-panel--iva   .ivcp-col-title { color: #1D1D1F; }

  .ivcp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .ivcp-row {
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    font-size: .8rem;
    line-height: 1.4;
  }

  .ivcp-row--bad  { color: rgba(29,29,31,0.38); }
  .ivcp-row--good { color: #1D1D1F; }

  .ivcp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: .1rem;
  }

  .ivcp-icon--bad  { color: rgba(29,29,31,0.28); }
  .ivcp-icon--good { color: #1D1D1F; }

  /* ── DESKTOP STORT ── */
  @media (min-width: 769px) {
    .ivcp { padding: 3rem 0 6rem; }
    .ivcp-inner {
      max-width: 1920px;
      padding: 0 4rem;
      gap: 2.5rem;
      grid-template-columns: minmax(210px, 270px) 1fr 1fr;
    }
    .ivcp-heading { font-size: 2.6rem; letter-spacing: -.3px; }
    .ivcp-desc { font-size: 1rem; }
    .ivcp-panel { padding: 3rem 2.5rem; gap: 2.5rem; min-height: 360px; border-radius: 24px; }
    .ivcp-panel-img { flex: 0 0 42%; }
    .ivcp-img { max-height: 340px; }
    .ivcp-col-title { font-size: .75rem; letter-spacing: 2.5px; margin-bottom: 1.4rem; }
    .ivcp-list { gap: 1.1rem; }
    .ivcp-row { font-size: 1rem; gap: .7rem; }
    .ivcp-icon { width: 22px; height: 22px; }
    .ivcp-icon svg { width: 16px; height: 16px; }
  }

  @media (max-width: 1100px) {
    .ivcp-inner { padding: 0 2rem; gap: 1.5rem; }
    .ivcp-panel { padding: 1.5rem 1.1rem; gap: 1rem; }
    .ivcp-img { max-height: 190px; }
    .ivcp-row { font-size: .75rem; }
  }

  /* ── TABLET ── */
  @media (max-width: 860px) {
    .ivcp-inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }
    .ivcp-left {
      grid-column: 1 / 3;
      text-align: center;
    }
    .ivcp-panel--plain { grid-column: 1; }
    .ivcp-panel--iva   { grid-column: 2; }
  }

  /* ── MOBIL ── */
  @media (max-width: 600px) {
    .ivcp {
      padding: 2rem 0 3rem;
      background: linear-gradient(180deg, #f9f3eb 0%, #f0e6d3 25%, #f0e6d3 88%, #f9f3eb 97%, #faf6f0 100%);
    }
    .ivcp-inner {
      display: flex;
      flex-direction: column;
      padding: 0 1.25rem;
      gap: 1.25rem;
    }
    .ivcp-heading {
      font-size: 1.6rem;
      letter-spacing: -.3px;
      text-align: center;
    }
    .ivcp-desc {
      font-size: .85rem;
      text-align: center;
    }
    .ivcp-panel { padding: 1.6rem 1.25rem; min-height: unset; border-radius: 14px; gap: 1rem; }
    .ivcp-panel-img { flex: 0 0 55%; }
    .ivcp-img { max-height: 320px; }
    .ivcp-col-title { font-size: .65rem; margin-bottom: .85rem; }
    .ivcp-row { font-size: .82rem; gap: .5rem; }
    .ivcp-icon svg { width: 13px; height: 13px; }
  }
</style>

{% schema %}
{
  "name": "IVA Jämförelse",
  "settings": [
    { "type": "color",        "id": "bg_color",        "label": "Bakgrundsfärg",         "default": "#EBF4FB" },
    { "type": "textarea",     "id": "heading",         "label": "Rubrik",                 "default": "Varför IVA?" },
    { "type": "textarea",     "id": "description",     "label": "Beskrivning",            "default": "Vi kombinerar skydd, stil och smart förvaring i ett skal som förenklar din vardag. Designat för dig som vill mer, utan att kompromissa med stilen." },
    { "type": "image_picker", "id": "image_plain",     "label": "Bild – vanligt skal" },
    { "type": "image_picker", "id": "image_iva",       "label": "Bild – IVA-skal" },
    { "type": "text",         "id": "col_plain_title", "label": "Kolumnrubrik: vanligt",  "default": "Vanligt mobilskal" },
    { "type": "text",         "id": "col_iva_title",   "label": "Kolumnrubrik: IVA",      "default": "IVA mobilskal" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Jämförelserad",
      "settings": [
        { "type": "text", "id": "plain_text", "label": "Vanligt skal – text", "default": "Bara skydd" },
        { "type": "text", "id": "iva_text",   "label": "IVA-skal – text",    "default": "Skydd + smart förvaring" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IVA Jämförelse",
      "blocks": [
        { "type": "row", "settings": { "plain_text": "Bara skydd",         "iva_text": "Skydd + smart förvaring" } },
        { "type": "row", "settings": { "plain_text": "Behöver väska",      "iva_text": "Mindre att bära" } },
        { "type": "row", "settings": { "plain_text": "Ingen organisering", "iva_text": "Allt på sin plats" } },
        { "type": "row", "settings": { "plain_text": "Standarddesign",     "iva_text": "Innovativ premiumdesign" } },
        { "type": "row", "settings": { "plain_text": "Inget mervärde",      "iva_text": "Design med syfte" } }
      ]
    }
  ]
}
{% endschema %}