{%- comment -%}
  IVA – Kontakta oss (sections/iva-kontakt.liquid). Sida: /pages/kontakt (mall "kontakt").
  Formuläret använder Shopifys kontaktformulär → mejl till butikens kontaktadress (Inställningar → Butiksuppgifter).
{%- endcomment -%}

<section class="ivk2">
  <div class="ivk2-grid">
    <div class="ivk2-left">
      <p class="ivk2-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ivk2-intro">{{ section.settings.intro }}</p>

      <ul class="ivk2-info">
        {%- if section.settings.email2 != blank -%}
          <li><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div><b>E-post</b><a href="mailto:{{ section.settings.email2 }}">{{ section.settings.email2 }}</a></div></li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><b>Svarstid</b><span>{{ section.settings.hours }}</span></div></li>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <li><svg viewBox="0 0 24 24"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><div><b>Adress</b><span>{{ section.settings.address | newline_to_br }}</span></div></li>
        {%- endif -%}
        {%- if section.settings.company != blank -%}
          <li><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16"/></svg><div><b>Företagsuppgifter</b><span>{{ section.settings.company | newline_to_br }}</span></div></li>
        {%- endif -%}
      </ul>

    </div>

    <div class="ivk2-card">
      {%- form 'contact', id: 'ivkContact', class: 'ivk2-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="ivk2-ok">
            <h2>Tack för ditt meddelande!</h2>
            <p>Vi har tagit emot det och återkommer inom 2 arbetsdagar.</p>
            <a class="ivk2-btn" href="{{ routes.collections_url }}/produkter">Fortsätt handla</a>
          </div>
        {%- else -%}
          <h2>{{ section.settings.form_heading }}</h2>
          <p class="ivk2-sub">{{ section.settings.form_text }}</p>
          {%- if form.errors -%}
            <div class="ivk2-err">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="ivk2-row">
            <div class="ivk2-field"><label for="ivkFirst">Förnamn</label><input type="text" id="ivkFirst" name="contact[Förnamn]" required autocomplete="given-name"></div>
            <div class="ivk2-field"><label for="ivkLast">Efternamn</label><input type="text" id="ivkLast" name="contact[Efternamn]" autocomplete="family-name"></div>
          </div>
          <div class="ivk2-field"><label for="ivkEmail">E-post</label><input type="email" id="ivkEmail" name="contact[email]" required autocomplete="email" value="{% if customer %}{{ customer.email }}{% endif %}"></div>
          <div class="ivk2-row">
            <div class="ivk2-field"><label for="ivkOrder">Ordernummer <em>(valfritt)</em></label><input type="text" id="ivkOrder" name="contact[Ordernummer]" placeholder="#1001"></div>
            <div class="ivk2-field"><label for="ivkTopic">Ärende</label>
              <select id="ivkTopic" name="contact[Ärende]">
                <option>Fråga om min order</option><option>Produktfråga</option><option>Retur eller reklamation</option><option>Samarbete</option><option>Annat</option>
              </select>
            </div>
          </div>
          <div class="ivk2-field"><label for="ivkMsg">Meddelande</label><textarea id="ivkMsg" name="contact[body]" rows="6" required placeholder="Berätta vad vi kan hjälpa dig med…"></textarea></div>
          <button type="submit" class="ivk2-btn ivk2-btn--wide">Skicka meddelande</button>
          <p class="ivk2-fine">Vi behandlar dina uppgifter enligt vår <a href="/pages/personuppgiftspolicy">personuppgiftspolicy</a> och använder dem bara för att svara på ditt ärende.</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="ivk2-quick">
      <p class="ivk2-eyebrow">Snabba svar</p>
      <a href="/pages/spara-order">Spåra min order →</a>
      <a href="/pages/retur">Starta en retur →</a>
      <a href="/pages/hjalpcenter">Vanliga frågor →</a>
    </div>
  </div>
</section>

<style>
  .ivk2 { background: #faf6f0; color: #1D1D1F; padding: 2.5rem 1.25rem 4rem; margin-bottom: -2px; }
  .ivk2 * { box-sizing: border-box; }
  .ivk2-grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1fr; grid-template-areas: "left" "card" "quick"; gap: 2.5rem; align-items: start; }
  .ivk2-left { grid-area: left; }
  .ivk2-card { grid-area: card; }
  .ivk2-quick { grid-area: quick; }
  .ivk2-eyebrow { font-size: .65rem; letter-spacing: 3px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .6rem; }
  .ivk2 h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(2.4rem, 4vw, 3.4rem); margin: .2rem 0 1rem; color: #1D1D1F !important; line-height: 1.1; }
  .ivk2-intro { color: rgba(29,29,31,.65); max-width: 440px; margin: 0 0 2rem; line-height: 1.65; }
  .ivk2-info { list-style: none; margin: 0; padding: 1.8rem 0; border-top: 1px solid rgba(29,29,31,.1); border-bottom: 1px solid rgba(29,29,31,.1); display: grid; gap: 1.3rem; }
  .ivk2-info li { display: flex; gap: 1rem; align-items: flex-start; }
  .ivk2-info svg { width: 22px; height: 22px; stroke: #1D1D1F; fill: none; stroke-width: 1.4; flex: none; margin-top: .15rem; }
  .ivk2-info b { display: block; font-size: .66rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(29,29,31,.62); margin-bottom: .15rem; }
  .ivk2-info a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .ivk2-info span { font-size: .95rem; line-height: 1.5; }
  .ivk2-quick { margin-top: -1rem; }
  .ivk2-quick a { display: block; padding: .55rem 0; font-size: .95rem; border-bottom: 1px solid rgba(29,29,31,.1); color: inherit; text-decoration: none; transition: padding-left .2s; }
  .ivk2-quick a:hover { padding-left: .3rem; }
  .ivk2-card { background: #f7f3eb; border: 1px solid rgba(29,29,31,.09); border-radius: 18px; padding: 1.8rem 1.4rem; }
  .ivk2-card h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 1.9rem; margin: 0 0 .3rem; color: #1D1D1F !important; }
  .ivk2-sub { color: rgba(29,29,31,.65); font-size: .9rem; margin: 0 0 1.5rem; }
  .ivk2-row { display: grid; grid-template-columns: 1fr; gap: 0 1rem; }
  .ivk2-field { margin-bottom: 1rem; }
  .ivk2-field label { display: block; font-size: .66rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .45rem; }
  .ivk2-field label em { font-style: normal; text-transform: none; letter-spacing: 0; }
  .ivk2-field input, .ivk2-field select, .ivk2-field textarea { width: 100%; background: #fff; border: 1px solid rgba(29,29,31,.12); border-radius: 12px; padding: .9rem 1.1rem; font: inherit; font-size: .92rem; color: #1D1D1F; outline: none; transition: border-color .2s; }
  .ivk2-field input:focus, .ivk2-field select:focus, .ivk2-field textarea:focus { border-color: #1D1D1F; }
  .ivk2-field textarea { resize: vertical; min-height: 140px; }
  .ivk2-btn { display: inline-flex; align-items: center; justify-content: center; background: #1D1D1F; color: #fff !important; border: 1.5px solid #1D1D1F; border-radius: 50px; padding: 1rem 1.8rem; font-size: .68rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; cursor: pointer; font-family: inherit; transition: transform .2s, box-shadow .2s; }
  .ivk2-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.16); }
  .ivk2-btn--wide { width: 100%; }
  .ivk2-fine { font-size: .74rem; color: rgba(29,29,31,.6); text-align: center; margin: 1rem 0 0; line-height: 1.5; }
  .ivk2-fine a { color: inherit; text-decoration: underline; }
  .ivk2-err { background: rgba(192,57,43,.08); border: 1px solid rgba(192,57,43,.25); color: #8e2a1f; border-radius: 12px; padding: .8rem 1rem; font-size: .85rem; margin-bottom: 1rem; }
  .ivk2-ok { text-align: center; padding: 2rem 0; }
  .ivk2-ok p { color: rgba(29,29,31,.65); margin: .4rem 0 1.4rem; }
  @media (min-width: 860px) {
    .ivk2 { padding: 4.5rem 2.5rem 5rem; }
    .ivk2-grid { grid-template-columns: 1fr 1.15fr; grid-template-areas: "left card" "quick card"; gap: 1.8rem 5rem; }
    .ivk2-quick { margin-top: 0; }
    .ivk2-row { grid-template-columns: 1fr 1fr; }
    .ivk2-card { padding: 2.6rem; }
  }
</style>

{% schema %}
{
  "name": "IVA Kontakta oss",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Liten rubrik", "default": "Kontakta oss" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vi hjälper dig gärna." },
    { "type": "textarea", "id": "intro", "label": "Inledning", "default": "Har du en fråga om din order, ett skal eller vill du bara säga hej? Skriv till oss så återkommer vi inom 2 arbetsdagar." },
    { "type": "header", "content": "Kontaktuppgifter" },
    { "type": "text", "id": "email2", "label": "E-post", "default": "iam@ivadesign.se" },
    { "type": "text", "id": "hours", "label": "Svarstid", "default": "Vardagar · svar inom 2 arbetsdagar" },
    { "type": "textarea", "id": "address", "label": "Adress (töm fältet för att dölja)", "default": "Ninni Kronbergs gata 20\n113 68 Stockholm" },
    { "type": "textarea", "id": "company", "label": "Företagsuppgifter", "default": "2M Interlokal AB\nOrg.nr 559356-3991" },
    { "type": "header", "content": "Formulär" },
    { "type": "text", "id": "form_heading", "label": "Rubrik", "default": "Skicka ett meddelande" },
    { "type": "text", "id": "form_text", "label": "Text", "default": "Fyll i formuläret så hör vi av oss via e-post." }
  ],
  "presets": [ { "name": "IVA Kontakta oss" } ]
}
{% endschema %}