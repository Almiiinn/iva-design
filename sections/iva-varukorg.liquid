{%- comment -%}
  IVA – Varukorg (sections/iva-varukorg.liquid). Används av templates/cart.json.
  Uppdaterar antal via /cart/change.js utan omladdning. Fraktrad med fast pris, rekommendationer, kassa-knapp.
{%- endcomment -%}

<section class="ivcart" id="ivCart">
  <div class="ivcart-inner">
    <p class="ivcart-eyebrow">Din varukorg</p>
    <h1 class="ivcart-title">Varukorg <span id="ivCartCount">({{ cart.item_count }})</span></h1>

    {%- if cart.item_count == 0 -%}
      <div class="ivcart-empty" id="ivCartEmpty">
        <p>Din varukorg är tom.</p>
        <a class="ivcart-btn" href="{{ routes.collections_url }}/produkter">Se kollektionen</a>
      </div>
    {%- else -%}
      <div class="ivcart-grid" id="ivCartGrid">
        <div class="ivcart-items">
          {%- for item in cart.items -%}
            <div class="ivcart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <a class="ivcart-img" href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="300" height="{{ 300 | divided_by: item.image.aspect_ratio | round }}" loading="lazy">{%- endif -%}
              </a>
              <div class="ivcart-info">
                <a class="ivcart-name" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}<span class="ivcart-var">{{ item.variant.title }}</span>{%- endif -%}
                <span class="ivcart-price">{{ item.final_price | money }}</span>
                <div class="ivcart-qty">
                  <button type="button" class="ivcart-qbtn" data-dir="-1" aria-label="Minska">−</button>
                  <input type="number" min="0" value="{{ item.quantity }}" class="ivcart-qin" aria-label="Antal">
                  <button type="button" class="ivcart-qbtn" data-dir="1" aria-label="Öka">+</button>
                  <button type="button" class="ivcart-remove">Ta bort</button>
                </div>
              </div>
              <div class="ivcart-line-total">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="ivcart-summary">
          <h2>Sammanfattning</h2>
          <div class="ivcart-row"><span>Delsumma</span><span id="ivSubtotal">{{ cart.total_price | money }}</span></div>
          <div class="ivcart-row ivcart-row--muted"><span>Frakt</span><span>{{ section.settings.shipping_text }}</span></div>
          <div class="ivcart-row ivcart-row--total"><span>Totalt</span><span id="ivTotal">{{ cart.total_price | money }}</span></div>
          <p class="ivcart-small">Inkl. moms. Betala med Klarna, kort, Apple Pay eller Google Pay.</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="ivcart-btn ivcart-btn--wide">Till kassan →</button>
          </form>
          <a class="ivcart-continue" href="{{ routes.collections_url }}/produkter">← Fortsätt handla</a>
          <div class="ivcart-trust">
            {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'ivcart-pay' }}{%- endfor -%}
          </div>
        </aside>
      </div>
    {%- endif -%}

    {%- if section.settings.show_reco -%}
      {%- assign reco = collections.all.products -%}
      {%- assign cart_ids = cart.items | map: 'product_id' -%}
      <div class="ivcart-reco">
        <p class="ivcart-eyebrow" style="text-align:center">Du kanske också gillar</p>
        <div class="ivcart-reco-grid">
          {%- assign shown = 0 -%}
          {%- for p in reco limit: 40 -%}
            {%- if shown >= 4 or p.available == false -%}{%- continue -%}{%- endif -%}
            {%- if cart_ids contains p.id -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <a class="ivcart-card" href="{{ p.url }}">
              <div class="ivcart-card-img">
                <img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}" loading="lazy" width="500" height="{{ 500 | divided_by: p.featured_image.aspect_ratio | round }}">
              </div>
              <b>{{ p.title }}</b><span>{{ p.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .ivcart { background: #faf6f0; color: #1D1D1F; padding: 2.5rem 1.25rem 5rem; margin-bottom: -2px; }
  .ivcart * { box-sizing: border-box; }
  .ivcart-inner { max-width: 1180px; margin: 0 auto; }
  .ivcart-eyebrow { font-size: .65rem; letter-spacing: 3px; text-transform: uppercase; color: rgba(29,29,31,.62); margin: 0 0 .5rem; }
  .ivcart-title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: clamp(2.2rem, 4vw, 3rem); margin: 0 0 1.6rem; color: #1D1D1F !important; }
  .ivcart-title span { font-size: .5em; color: rgba(29,29,31,.55); font-family: inherit; }
  .ivcart-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
  .ivcart-ship { background: #f3ecdf; border-radius: 14px; padding: .9rem 1.1rem; margin-bottom: 1rem; }
  .ivcart-ship p { margin: 0 0 .55rem; font-size: .85rem; }
  .ivcart-bar { height: 6px; background: rgba(29,29,31,.1); border-radius: 3px; overflow: hidden; }
  .ivcart-bar i { display: block; height: 100%; background: #1D1D1F; border-radius: 3px; transition: width .4s; }
  .ivcart-item { display: grid; grid-template-columns: 88px 1fr auto; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid rgba(29,29,31,.09); align-items: start; }
  .ivcart-item.is-removing { opacity: .4; pointer-events: none; }
  .ivcart-img { display: block; width: 88px; aspect-ratio: 3/4; border-radius: 12px; background: #f3ecdf; overflow: hidden; }
  .ivcart-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ivcart-info { min-width: 0; }
  .ivcart-name { display: block; font-weight: 600; font-size: .95rem; text-decoration: none; color: inherit; }
  .ivcart-var { display: block; font-size: .8rem; color: rgba(29,29,31,.62); margin-top: .15rem; }
  .ivcart-price { display: block; font-size: .85rem; margin-top: .25rem; }
  .ivcart-qty { display: flex; align-items: center; gap: .3rem; margin-top: .7rem; }
  .ivcart-qbtn { width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(29,29,31,.2); background: #fff; font-size: 1rem; cursor: pointer; line-height: 1; }
  .ivcart-qin { width: 44px; height: 32px; text-align: center; border: 1px solid rgba(29,29,31,.15); border-radius: 8px; background: #fff; font: inherit; -moz-appearance: textfield; }
  .ivcart-qin::-webkit-outer-spin-button, .ivcart-qin::-webkit-inner-spin-button { -webkit-appearance: none; }
  .ivcart-remove { background: none; border: 0; font-size: .75rem; color: rgba(29,29,31,.55); text-decoration: underline; cursor: pointer; margin-left: .5rem; font-family: inherit; }
  .ivcart-line-total { font-weight: 600; font-size: .95rem; white-space: nowrap; }
  .ivcart-summary { background: #f7f3eb; border: 1px solid rgba(29,29,31,.09); border-radius: 18px; padding: 1.5rem 1.6rem; }
  .ivcart-summary h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-size: 1.5rem; margin: 0 0 1rem; color: #1D1D1F !important; }
  .ivcart-row { display: flex; justify-content: space-between; font-size: .9rem; padding: .35rem 0; }
  .ivcart-row--muted { color: rgba(29,29,31,.62); }
  .ivcart-row--total { font-weight: 600; font-size: 1.05rem; border-top: 1px solid rgba(29,29,31,.1); margin-top: .5rem; padding-top: .8rem; }
  .ivcart-small { font-size: .75rem; color: rgba(29,29,31,.6); margin: .5rem 0 1rem; }
  .ivcart-btn { display: inline-flex; align-items: center; justify-content: center; background: #1D1D1F; color: #fff !important; border: 1.5px solid #1D1D1F; border-radius: 50px; padding: 1rem 1.8rem; font-size: .7rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; cursor: pointer; font-family: inherit; transition: transform .2s, box-shadow .2s; }
  .ivcart-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.16); }
  .ivcart-btn--wide { width: 100%; }
  .ivcart-continue { display: block; text-align: center; font-size: .8rem; margin-top: .9rem; color: inherit; }
  .ivcart-trust { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; margin-top: 1rem; }
  .ivcart-pay { height: 22px; width: auto; }
  .ivcart-empty { text-align: center; padding: 3rem 0 2rem; }
  .ivcart-empty p { color: rgba(29,29,31,.65); margin: 0 0 1.3rem; }
  .ivcart-reco { margin-top: 3.5rem; }
  .ivcart-reco-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem; margin-top: 1rem; }
  .ivcart-card { display: block; background: #f3ecdf; border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; }
  .ivcart-card-img { aspect-ratio: 3/4; overflow: hidden; }
  .ivcart-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s; }
  .ivcart-card:hover img { transform: scale(1.04); }
  .ivcart-card b { display: block; padding: .8rem 1rem 0; font-size: .88rem; font-weight: 600; }
  .ivcart-card span { display: block; padding: .2rem 1rem 1rem; font-size: .82rem; color: rgba(29,29,31,.65); }
  @media (min-width: 860px) {
    .ivcart { padding: 3.5rem 2.5rem 6rem; }
    .ivcart-grid { grid-template-columns: 1.6fr 1fr; gap: 3rem; }
    .ivcart-summary { position: sticky; top: 100px; }
    .ivcart-item { grid-template-columns: 110px 1fr auto; }
    .ivcart-img { width: 110px; }
    .ivcart-reco-grid { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ivCart'); if (!root) return;
    var money = function (c) { return (c / 100).toLocaleString('sv-SE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kr'; };
    function refresh(cart) {
      document.getElementById('ivCartCount').textContent = '(' + cart.item_count + ')';
      var st = document.getElementById('ivSubtotal'), tt = document.getElementById('ivTotal');
      if (st) st.textContent = money(cart.total_price); if (tt) tt.textContent = money(cart.total_price);
      cart.items.forEach(function (it) {
        var row = root.querySelector('[data-key="' + it.key + '"]'); if (!row) return;
        row.querySelector('.ivcart-line-total').textContent = money(it.final_line_price);
        row.querySelector('.ivcart-qin').value = it.quantity;
      });
      root.querySelectorAll('.ivcart-item').forEach(function (row) {
        if (!cart.items.some(function (it) { return it.key === row.dataset.key; })) row.remove();
      });
      document.querySelectorAll('.cart-count').forEach(function (el) { el.textContent = cart.item_count; el.style.display = cart.item_count > 0 ? '' : 'none'; });
      if (cart.item_count === 0) location.reload();
    }
    function change(row, qty) {
      row.classList.add('is-removing');
      fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: row.dataset.key, quantity: qty }) })
        .then(function (r) { return r.json(); }).then(function (cart) { row.classList.remove('is-removing'); refresh(cart); })
        .catch(function () { location.reload(); });
    }
    root.addEventListener('click', function (e) {
      var row = e.target.closest('.ivcart-item'); if (!row) return;
      var qin = row.querySelector('.ivcart-qin');
      if (e.target.classList.contains('ivcart-qbtn')) change(row, Math.max(0, (parseInt(qin.value, 10) || 0) + parseInt(e.target.dataset.dir, 10)));
      if (e.target.classList.contains('ivcart-remove')) change(row, 0);
    });
    root.addEventListener('change', function (e) {
      if (e.target.classList.contains('ivcart-qin')) change(e.target.closest('.ivcart-item'), Math.max(0, parseInt(e.target.value, 10) || 0));
    });
  })();
</script>

{% schema %}
{
  "name": "IVA Varukorg",
  "settings": [
    { "type": "text", "id": "shipping_text", "label": "Frakttext i sammanfattningen", "default": "45 kr · PostNord, 1–5 vardagar" },
    { "type": "checkbox", "id": "show_reco", "label": "Visa \"Du kanske också gillar\"", "default": true }
  ],
  "presets": [ { "name": "IVA Varukorg" } ]
}
{% endschema %}